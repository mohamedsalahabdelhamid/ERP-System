# =====================================================================
# ERP System - Environment variables (example)
# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# =====================================================================

# ---- Application ----
APP_NAME="ERP System"
APP_ENV=local            # local | staging | production
DEBUG=true
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
API_V1_PREFIX=/api/v1

# ---- PostgreSQL (used by both the `web` app and the `db` container) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_password_change_me

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- Web server ----
WEB_HOST=0.0.0.0
WEB_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=1440
